<?xml version="1.0" encoding="utf-8"?>
<app.tuxguitar.android.view.sheet.TGQuickSheet xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/tgQuickSheet"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layout_gravity="bottom"
	android:background="?attr/darkColor"
	android:clickable="true"
	android:elevation="8dp"
	android:focusable="true"
	android:orientation="vertical"
	android:paddingLeft="8dp"
	android:paddingRight="8dp"
	android:paddingBottom="8dp">

	<View
		android:id="@+id/quick_sheet_handle"
		android:layout_width="36dp"
		android:layout_height="4dp"
		android:layout_gravity="center_horizontal"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="8dp"
		android:background="@drawable/bg_quick_sheet_handle"/>

	<LinearLayout
		android:id="@+id/quick_sheet_peek"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:orientation="horizontal">

		<ImageButton
			android:id="@+id/quick_sheet_metronome"
			android:contentDescription="@string/action_transport_metronome"
			style="@style/TGQuickSheetButton.Metronome"/>

		<ImageButton
			android:id="@+id/quick_sheet_keyboard"
			android:contentDescription="@string/action_tab_keyboard_toggle"
			style="@style/TGQuickSheetButton.Keyboard"/>

		<ImageButton
			android:id="@+id/quick_sheet_count_in"
			android:contentDescription="@string/action_transport_count_down"
			style="@style/TGQuickSheetButton.CountIn"/>
	</LinearLayout>

	<include
		android:id="@+id/tgTabKeyboard"
		layout="@layout/view_tab_keyboard"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:visibility="gone"/>

	<androidx.core.widget.NestedScrollView
		android:id="@+id/quick_sheet_expanded"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="false">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingTop="8dp"
			android:paddingBottom="8dp">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:paddingTop="4dp"
				android:paddingBottom="4dp"
				android:text="@string/quick_sheet_play"
				android:textColor="@color/lightestColor"
				android:textStyle="bold"/>

			<Button
				android:id="@+id/quick_sheet_stop"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:text="@string/action_transport_stop"
				style="@style/TGQuickSheetMenuButton"/>

			<Button
				android:id="@+id/quick_sheet_play_mode"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:text="@string/action_transport_mode"
				style="@style/TGQuickSheetMenuButton"/>

			<CheckBox
				android:id="@+id/quick_sheet_loop_start"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:buttonTint="@color/lightestColor"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:text="@string/action_transport_set_loop_start"
				android:textColor="?attr/textLightColorSelector"/>

			<CheckBox
				android:id="@+id/quick_sheet_loop_end"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:buttonTint="@color/lightestColor"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:text="@string/action_transport_set_loop_end"
				android:textColor="?attr/textLightColorSelector"/>

			<CheckBox
				android:id="@+id/quick_sheet_highlight"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:buttonTint="@color/lightestColor"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:text="@string/action_transport_highlight_played_beat"
				android:textColor="?attr/textLightColorSelector"/>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:paddingTop="12dp"
				android:paddingBottom="4dp"
				android:text="@string/quick_sheet_edit"
				android:textColor="@color/lightestColor"
				android:textStyle="bold"/>

			<Button
				android:id="@+id/quick_sheet_edit"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:text="@string/action_menu_edit"
				style="@style/TGQuickSheetMenuButton"/>

			<Button
				android:id="@+id/quick_sheet_duration"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:text="@string/action_menu_duration"
				style="@style/TGQuickSheetMenuButton"/>

			<Button
				android:id="@+id/quick_sheet_dynamic"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:text="@string/action_menu_dynamic"
				style="@style/TGQuickSheetMenuButton"/>

			<Button
				android:id="@+id/quick_sheet_effects"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:text="@string/action_menu_effects"
				style="@style/TGQuickSheetMenuButton"/>

			<Button
				android:id="@+id/quick_sheet_beat"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:text="@string/action_menu_beat"
				style="@style/TGQuickSheetMenuButton"/>

			<Button
				android:id="@+id/quick_sheet_measure"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:text="@string/action_menu_measure"
				style="@style/TGQuickSheetMenuButton"/>

			<Button
				android:id="@+id/quick_sheet_track"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:text="@string/action_menu_track"
				style="@style/TGQuickSheetMenuButton"/>

			<Button
				android:id="@+id/quick_sheet_composition"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:text="@string/action_menu_composition"
				style="@style/TGQuickSheetMenuButton"/>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</app.tuxguitar.android.view.sheet.TGQuickSheet>
